{
    "$schema": "https://raw.githubusercontent.com/bsmg/BSIPA-MetadataFileSchema/master/Schema.json",
    "id": "HRZone",
    "name": "HR Zone",
    "author": "GxocT",
    "version": "0.3.0",
    "icon": "HRZone.Resources.hrzone.png",
    "description": "A custom counter mod that displays your heart rate in game.",
    "gameVersion": "1.40.8",
    "dependsOn": {
        "BSIPA": "^4.3.6",
        "BeatSaberMarkupLanguage": "^1.12.0",
        "SiraUtil": "^3.0.0"
    },
    "loadAfter": [
        "Counters+",
        "BeatLeader",
        "ScoreSaber"
    ],
    "links": {
        "project-source": "https://github.com/GxocT/HRZone"
    },
    "features": {
        "CountersPlus.CustomCounter": {
            "Name": "HRZone",
            "Description": "A counter that displays your heart rate in game.",
            "MultiplayerReady": true,
            "CounterLocation": "HRZone.HRZoneCountersPlus",
            "ConfigDefaults": {
                "Enabled": true,
                "Position": "BelowCombo",
                "Distance": 0
            },
            "BSML": {
                "Resource": "HRZone.UI.BSML.countersPlus.bsml",
                "Host": "HRZone.UI.CountersPlus.SettingController",
                "Icon": "HRZone.Resources.hrzone.png"
            }
        }
    }
}
