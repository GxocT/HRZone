<vertical child-control-height='false' child-expand-height="false" spacing="2" xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
          xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>
    <macro.define id="tab-width" value="90"/>
    <macro.define id="vertical-spacing" value="1.5"/>
    <tab-selector tab-tag='tabs'/>
    <tab tab-name-key="HRZONE_CONFIG_MENU_TAB_GENERAL" tags="tabs">
        <vertical child-control-height='false' spacing="~vertical-spacing" horizontal-fit="PreferredSize" pref-width="~tab-width">
            <bool-setting text-key="HRZONE_CONFIG_MENU_MOD_ENABLE_LABEL" value="ModEnable" apply-on-change="true" bind-value="true"/>
            <bool-setting text-key="HRZONE_CONFIG_MENU_NO_BLOOM_LABEL" value="NoBloom" hover-hint-key="HRZONE_CONFIG_MENU_NO_BLOOM_HINT"
                          apply-on-change="true" bind-value="true"/>
            <bool-setting text-key="HRZONE_CONFIG_MENU_AUTO_HIDE_LABEL" value="AutoHideCounter" hover-hint-key="HRZONE_CONFIG_MENU_AUTO_HIDE_HINT"
                          apply-on-change="true" bind-value="true"/>
        </vertical>
    </tab>
    <tab tab-name-key="HRZONE_CONFIG_MENU_TAB_ICON" tags="tabs">
        <vertical child-control-height='false' spacing="~vertical-spacing" horizontal-fit="PreferredSize" pref-width="~tab-width">
            <horizontal>
                <vertical background="round-rect-panel" pad="1">
                    <list id='icon-list' select-cell='OnIconListCellSelect' show-scrollbar="false"/>
                </vertical>
                <vertical child-control-height="false" pad-left="0" preferred-width="10" horizontal-fit="PreferredSize">
                    <button text-key="HRZONE_COMMON_REFRESH" on-click="RefreshIconOptions" interactable="~IsIconListLoaded" pad-top="4"/>
                    <page-button event-click='icon-list#PageUp' direction='Up' size-delta-y="10" size-delta-x="10"/>
                    <page-button event-click='icon-list#PageDown' direction='Down' size-delta-y="10" size-delta-x="10"/>
                </vertical>
            </horizontal>
            <horizontal horizontal-fit="PreferredSize" pref-width="100">
                <text text-key="HRZONE_CONFIG_MENU_ICON_FOLDER_LOCATION_HINT" align="Center" italics="false"/>
                <button text-key="HRZONE_CONFIG_MENU_ICON_OPEN_EXPLORER_BUTTON" on-click="OpenIconsFolder" pad-left="8"/>
            </horizontal>
        </vertical>
    </tab>
    <tab tab-name-key="HRZONE_CONFIG_MENU_TAB_HR_ZONE" tags="tabs">
        <vertical child-control-height='false' spacing="~vertical-spacing" horizontal-fit="PreferredSize" pref-width="~tab-width">
            <slider-setting text-key="HRZONE_CONFIG_MENU_MAX_HR_LABEL" show-buttons="true" value="MaxHR" integer-only="true" min="120" max="220"
                            increment="5" apply-on-change="true" bind-value="true"/>
            <horizontal horizontal-fit="PreferredSize" vertical-fit="PreferredSize" pref-width="~tab-width" child-align="MiddleCenter">
                <text text-key="HRZONE_CONFIG_MENU_MAX_HR_HINT" align="Center" word-wrapping="true"/>
            </horizontal>
        </vertical>
    </tab>
    <tab tab-name-key="HRZONE_CONFIG_MENU_TAB_THEME" tags="tabs">
        <vertical child-control-height='false' spacing="~vertical-spacing" horizontal-fit="PreferredSize" pref-width="~tab-width" child-align="UpperCenter">
            <bool-setting text-key="HRZONE_CONFIG_MENU_COLORIZE_ICON_LABEL" value="ColorizeIcon" hover-hint-key="HRZONE_CONFIG_MENU_COLORIZE_ICON_HINT"
                          apply-on-change="true" bind-value="true"/>
            <bool-setting text-key="HRZONE_CONFIG_MENU_COLORIZE_LABEL" value="Colorize" hover-hint-key="HRZONE_CONFIG_MENU_COLORIZE_HINT"
                          apply-on-change="true" bind-value="true"/>
            <dropdown-list-setting text-key="HRZONE_CONFIG_MENU_THEME_LABEL" value="ColorTheme" choices="ThemeOptions" formatter="GetThemeDisplayName"
                                   apply-on-change="true" bind-value="true"/>
            <color-setting text="~Zone1Text" value="Zone1Color" hover-hint-key="HRZONE_CONFIG_MENU_ZONE1_HINT" apply-on-change="true" bind-value="true"/>
            <color-setting text="~Zone2Text" value="Zone2Color" hover-hint-key="HRZONE_CONFIG_MENU_ZONE2_HINT" apply-on-change="true" bind-value="true"/>
            <color-setting text="~Zone3Text" value="Zone3Color" hover-hint-key="HRZONE_CONFIG_MENU_ZONE3_HINT" apply-on-change="true" bind-value="true"/>
            <color-setting text="~Zone4Text" value="Zone4Color" hover-hint-key="HRZONE_CONFIG_MENU_ZONE4_HINT" apply-on-change="true" bind-value="true"/>
            <color-setting text="~Zone5Text" value="Zone5Color" hover-hint-key="HRZONE_CONFIG_MENU_ZONE5_HINT" apply-on-change="true" bind-value="true"/>
        </vertical>
    </tab>
    <tab tab-name-key="HRZONE_CONFIG_MENU_TAB_MENU" tags="tabs">
        <vertical child-control-height='false' spacing="~vertical-spacing" horizontal-fit="PreferredSize" pref-width="~tab-width">
            <bool-setting text-key="HRZONE_CONFIG_MENU_SHOW_CLOCK_LABEL" value="ShowMenuClock" hover-hint-key="HRZONE_CONFIG_MENU_SHOW_CLOCK_HINT"
                          apply-on-change="true" bind-value="true"/>
            <bool-setting text-key="HRZONE_CONFIG_MENU_SHOW_HR_LABEL" value="ShowMenuHeartRate" hover-hint-key="HRZONE_CONFIG_MENU_SHOW_HR_HINT"
                          apply-on-change="true" bind-value="true"/>
            <dropdown-list-setting text-key="HRZONE_CONFIG_MENU_CLOCK_FORMAT_LABEL" value="MenuClockFormat" choices="ClockFormatOptions"
                                   apply-on-change="true" bind-value="true"/>
            <slider-setting text-key="HRZONE_CONFIG_MENU_BLOCK_HEIGHT_LABEL" value="MenuCounterHeight" min="-3" max="3" increment="0.1"
                            apply-on-change="true" bind-value="true"/>
            <slider-setting text-key="HRZONE_CONFIG_MENU_BLOCK_DISTANCE_LABEL" value="MenuCounterDistance" min="-3" max="3" increment="0.1"
                            apply-on-change="true" bind-value="true"/>
            <slider-setting text-key="HRZONE_CONFIG_MENU_BLOCK_TILT_LABEL" value="MenuCounterTilt" min="-45" max="45" increment="1"
                            apply-on-change="true" bind-value="true"/>
        </vertical>
    </tab>
    <tab tab-name-key="HRZONE_CONFIG_MENU_TAB_SERVER" tags="tabs">
        <vertical child-control-height='false' spacing="~vertical-spacing" horizontal-fit="PreferredSize" pref-width="~tab-width">
            <dropdown-list-setting text-key="HRZONE_DATA_SOURCE_MENU_SOURCE_DROPDOWN_LABEL" value="DataSource" choices="DataSourceOptions"
                                   formatter="GetDataSourceDisplayName" apply-on-change="true" bind-value="true"/>
            <vertical active="~IsWebRequestSource" child-control-height="false" spacing="~vertical-spacing" horizontal-fit="PreferredSize" pref-width="~tab-width">
                <string-setting text-key="HRZONE_DATA_SOURCE_MENU_FEED_URL_LABEL" value="FeedLink" apply-on-change="true" bind-value="true"/>
                <horizontal horizontal-fit="PreferredSize" vertical-fit="PreferredSize" pref-width="~tab-width" pref-height="10" child-align="MiddleCenter">
                    <macro.reparent transform="FeedPreviewCounter"/>
                </horizontal>
                <horizontal horizontal-fit="PreferredSize" vertical-fit="PreferredSize" pref-width="~tab-width" pref-height="4" child-align="MiddleCenter">
                    <text text="~FeedPreviewText" align="Center" italics="false" word-wrapping="true"/>
                </horizontal>
            </vertical>
        </vertical>
    </tab>
</vertical>
